  "item": [
    {
      "name": "Authentication",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Authentication successful\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Token was returned\", function () {",
              "    pm.expect(response.token).to.not.be.empty;",
              "});",
              "",
              "pm.environment.set(\"token\", response.token);",
              "",
              "pm.test(\"Token was saved\", function () {",
              "    pm.expect(pm.environment.get(\"token\")).to.eql(response.token);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\" : \"admin\",\n    \"password\" : \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseurl}}/auth",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Booking ID's",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Booking list is returned\", function () {",
              "    pm.expect(response).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Booking list is not empty\", function () {",
              "    pm.expect(response.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Each booking has an ID\", function () {",
              "    response.forEach(function (booking) {",
              "        pm.expect(booking).to.have.property(\"bookingid\");",
              "    });",
              "});",
              "",
              "pm.environment.set(\"bookingId\", response[0].bookingid);",
              "",
              "console.log(\"Booking ID saved:\", pm.environment.get(\"bookingId\"));",
              "console.log(\"BOOKING ID:\", response[0].bookingid);",
              "console.log(\"COLLECTION VARIABLE:\", pm.environment.get(\"bookingId\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{token}}",
            "type": "text"
          }
        ],
