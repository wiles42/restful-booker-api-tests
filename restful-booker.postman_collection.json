    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.environment.set(\"bookingId\", response.bookingid);",
              "",
              "pm.test(\"Booking ID was created\", function () {",
              "    pm.expect(response.bookingid).to.exist;",
              "});",
              "",
              "pm.test(\"Booking information is correct\", function () {",
              "    pm.expect(response.booking.firstname).to.eql(\"Wiley\");",
              "    pm.expect(response.booking.lastname).to.eql(\"Griffin\");",
              "    pm.expect(response.booking.totalprice).to.eql(111);",
              "    pm.expect(response.booking.depositpaid).to.eql(true);",
              "});",
              "",
              "pm.test(\"Booking dates are correct\", function () {",
              "    pm.expect(response.booking.bookingdates.checkin).to.eql(\"2026-01-01\");",
              "    pm.expect(response.booking.bookingdates.checkout).to.eql(\"2027-01-01\");",
              "});",
              "",
              "pm.test(\"Additional needs are correct\", function () {",
              "    pm.expect(response.booking.additionalneeds).to.eql(\"Breakfast\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
