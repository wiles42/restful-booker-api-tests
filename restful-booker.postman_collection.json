    {
      "name": "Update Booking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.environment.get(\"token\");",
              "",
              "if (!token) {",
              "    throw new Error(\"TOKEN IS MISSING!\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Booking updated successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"First name was updated\", function () {",
              "    pm.expect(response.firstname).to.eql(\"Wiley\");",
              "});",
              "",
              "pm.test(\"Last name was updated\", function () {",
              "    pm.expect(response.lastname).to.eql(\"Griffin\");",
              "});",
              "",
              "pm.test(\"Total price is correct\", function () {",
              "    pm.expect(response.totalprice).to.eql(111);",
              "});",
              "",
              "pm.test(\"Deposit paid is correct\", function () {",
              "    pm.expect(response.depositpaid).to.eql(true);",
              "});",
              "",
              "pm.test(\"Booking dates were updated\", function () {",
              "    pm.expect(response.bookingdates.checkin).to.eql(\"2026-02-01\");",
              "    pm.expect(response.bookingdates.checkout).to.eql(\"2027-01-01\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
